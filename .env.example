# ==================== Environment ====================
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

# ==================== Database ====================
POSTGRES_USER=givemeasign
POSTGRES_PASSWORD=givemeasign_dev
POSTGRES_DB=givemeasign
POSTGRES_PORT=5432
# Local-dev URL (outside docker). Compose overrides to postgres:5432 inside containers.
DATABASE_URL=postgresql+psycopg://givemeasign:givemeasign_dev@localhost:5432/givemeasign

# ==================== LLM ====================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Per-tier model overrides (defaults match the stack plan).
LLM_MODEL_TIER1=claude-haiku-4-5-20251001
LLM_MODEL_TIER2=claude-sonnet-4-6
LLM_MODEL_TIER3=claude-sonnet-4-6
LLM_MODEL_TIER4=claude-opus-4-6
EMBEDDING_MODEL=text-embedding-3-small

# ==================== Sources ====================
# Phase-0 (free/near-free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=givemeasign/0.1 by u/yourname
# Product Hunt developer token — create an app at
# https://www.producthunt.com/v2/oauth/applications and grab the "Developer Token".
PRODUCT_HUNT_TOKEN=
# Dev.to needs no auth — public Forem API.

# ---- Source diversification ----
# Seed queries for the HN search fetch, two flavors:
#   - Domain ("who suffers"): teachers, restaurants, parents, healthcare, …
#   - Mechanism ("what kind of product"): image processing, voice-to-text,
#     AI scheduling bots, messenger bots, calendar chaos, etc.
# Adjust freely; each seed drives a separate HN search query per run.
HN_SEARCH_SEEDS=small business tools,teachers struggle,restaurant operations,freelancer problems,parents need,healthcare workflow,accountant tedious,real estate paperwork,image processing tool,document scanning ocr,photo organization app,screenshot automation,voice to text,voice input productivity,meeting transcription,podcast editing workflow,personal ai assistant,ai scheduling bot,telegram bot productivity,whatsapp bot automation,calendar scheduling chaos,meal planning app,invoice automation,video editing workflow
HN_SEARCH_PER_SEED=5
HN_SHOW_LIMIT=10
# Dev.to tags the pipeline rotates through per run.
DEVTO_TAGS=discuss,productivity,career,writing,nocode,beginners,help,freelance,showdev
DEVTO_PER_TAG=4

# Phase-1 (paid, leave blank until activated)
AHREFS_API_KEY=

# ==================== Telegram ====================
TELEGRAM_BOT_TOKEN=
# Your Telegram user id — the bot will DM the daily deck here. Find via @userinfobot.
TELEGRAM_USER_ID=0

# ==================== Budgets (USD) ====================
DAILY_BUDGET_USD=5.00
MONTHLY_BUDGET_USD=150.00
